rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.uid == 'EplnbxgWTaal9N5QgflBWaT1LWG3'; }
    function validTime(value) {
      return value is string
        && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function validTemplate(data) {
      return data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 160
        && data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 160
        && data.dayOfWeek is int && data.dayOfWeek >= 0 && data.dayOfWeek <= 6
        && validTime(data.startTime) && validTime(data.endTime) && data.startTime < data.endTime
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 7
        && data.active is bool
        && data.note is string && data.note.size() <= 5000;
    }
    function validSession(data) {
      return data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 160
        && data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 160
        && data.dateKey is string && data.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.dayOfWeek is int && data.dayOfWeek >= 0 && data.dayOfWeek <= 6
        && data.date is timestamp
        && validTime(data.startTime) && validTime(data.endTime) && data.startTime < data.endTime
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 7
        && (!('usesMakeupCredit' in data) || data.usesMakeupCredit is bool)
        && data.note is string && data.note.size() <= 5000
        && data.type in ['regular', 'makeup']
        && (
          (data.type == 'regular' && data.status in ['scheduled', 'attended', 'absent', 'holiday', 'cancelled'])
          || (data.type == 'makeup' && data.status in ['makeup_scheduled', 'makeup_completed', 'holiday', 'cancelled'])
        );
    }
    function validStudent(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 200
        && data.shortName is string && data.shortName.size() <= 200
        && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.active is bool
        && data.makeupBalance is int && data.makeupBalance >= 0 && data.makeupBalance <= 10000
        && data.birthday is string && (data.birthday.size() == 0 || data.birthday.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.parentPhone is string && data.parentPhone.size() <= 100
        && data.note is string && data.note.size() <= 5000;
    }
    function validTeacher(data) {
      return data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 200
        && data.shortName is string && data.shortName.size() <= 200
        && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.active is bool
        && data.birthday is string && (data.birthday.size() == 0 || data.birthday.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.phone is string && data.phone.size() <= 100
        && data.note is string && data.note.size() <= 5000;
    }
    function validNote(data) {
      return data.dateKey is string && data.dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.title is string && data.title.size() <= 300
        && data.details is string && data.details.size() > 0 && data.details.size() <= 5000;
    }
    function validHoliday(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.startDate is string && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startDate <= data.endDate;
    }
    function validTeacherLeave(data) {
      return data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 160
        && data.startDate is string && data.startDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.endDate is string && data.endDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.startDate <= data.endDate
        && data.leaveType in ['full_day', 'session']
        && data.startTime is string && data.endTime is string
        && (data.leaveType == 'full_day' || (validTime(data.startTime) && validTime(data.endTime) && data.startTime < data.endTime))
        && data.note is string && data.note.size() <= 1000;
    }
    function validWeek(data) {
      return data.weekNumber is int && data.weekNumber > 0 && data.weekNumber <= 100000
        && data.startDate is timestamp && data.endDate is timestamp && data.startDate < data.endDate
        && data.label is string && data.label.size() > 0 && data.label.size() <= 300
        && data.status in ['active', 'closed'];
    }
    function validAudit(data) {
      return data.entityType is string && data.entityType.size() > 0 && data.entityType.size() <= 100
        && data.entityId is string && data.entityId.size() > 0 && data.entityId.size() <= 400
        && data.action is string && data.action.size() > 0 && data.action.size() <= 100
        && data.before is map && data.after is map
        && data.reason is string && data.reason.size() <= 5000
        && data.userId == request.auth.uid
        && data.createdAt == request.time;
    }
    function validMakeupTransaction(data) {
      return data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 160
        && data.type in ['credit', 'debit', 'reversal']
        && data.quantity is int && data.quantity != 0 && data.quantity >= -500 && data.quantity <= 500
        && data.reason is string && data.reason.size() <= 5000
        && data.idempotencyKey is string && data.idempotencyKey.size() > 0 && data.idempotencyKey.size() <= 500
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time;
    }
    function validStudentForm(data) {
      return data.keys().hasAll([
          'displayOrder', 'studentId', 'teacherId', 'formLink', 'formTitle',
          'courseStart', 'courseEnd', 'coursePeriod', 'resultRecordedDate',
          'teacherHours', 'note', 'sourceRow', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'displayOrder', 'studentId', 'teacherId', 'formLink', 'formTitle',
          'courseStart', 'courseEnd', 'coursePeriod', 'resultRecordedDate',
          'teacherHours', 'note', 'sourceRow', 'createdAt', 'updatedAt',
          'createdBy', 'updatedBy', 'linkHistory'
        ])
        && data.displayOrder is int && data.displayOrder >= 0
        && data.sourceRow is int && data.sourceRow >= 0
        && data.studentId is string && data.studentId.size() > 0 && data.studentId.size() <= 160
        && data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 160
        && exists(/databases/$(database)/documents/students/$(data.studentId))
        && exists(/databases/$(database)/documents/teachers/$(data.teacherId))
        && data.formLink is string && data.formLink.size() <= 2048
        && (data.formLink.size() == 0 || data.formLink.matches('^https?://.+'))
        && data.formTitle is string && data.formTitle.size() <= 500
        && data.courseStart is string && data.courseStart.size() <= 40
        && data.courseEnd is string && data.courseEnd.size() <= 40
        && data.coursePeriod is string && data.coursePeriod.size() <= 100
        && data.resultRecordedDate is string && data.resultRecordedDate.size() <= 10
        && (data.resultRecordedDate.size() == 0 || data.resultRecordedDate.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        && data.teacherHours is number && data.teacherHours >= 0 && data.teacherHours <= 10000
        && data.note is string && data.note.size() <= 5000
        && (!('linkHistory' in data) || (data.linkHistory is list && data.linkHistory.size() <= 50))
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.createdBy is string && data.updatedBy is string;
    }

    // Nhật ký và sổ giao dịch không được sửa; chủ sở hữu có thể xóa dữ liệu test.
    match /auditLogs/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validAudit(request.resource.data);
      allow update: if false;
      allow delete: if owner();
    }
    match /makeupTransactions/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && validMakeupTransaction(request.resource.data);
      allow update: if false;
      allow delete: if owner();
    }

    // Mọi tài khoản Authentication đều được quản lý dữ liệu nghiệp vụ.
    match /students/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && validStudent(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if signedIn() && validStudent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /teachers/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && validTeacher(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if signedIn() && validTeacher(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /studentForms/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validStudentForm(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if signedIn()
        && validStudentForm(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayOrder', 'studentId', 'teacherId', 'formLink', 'formTitle',
          'courseStart', 'courseEnd', 'coursePeriod', 'resultRecordedDate',
          'teacherHours', 'note', 'sourceRow', 'updatedAt', 'updatedBy',
          'linkHistory'
        ]);
      allow delete: if signedIn();
    }
    match /notes/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && validNote(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if signedIn() && validNote(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /holidays/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && validHoliday(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if signedIn() && validHoliday(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /teacherLeaves/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && validTeacherLeave(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if signedIn() && validTeacherLeave(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /scheduleTemplates/{id} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && validTemplate(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if signedIn() && validTemplate(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }
    match /users/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && id == request.auth.uid;
      allow delete: if owner() || (signedIn() && id == request.auth.uid);
    }
    match /weeks/{weekId} {
      allow read, delete: if signedIn();
      allow create: if signedIn() && validWeek(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if signedIn() && validWeek(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      match /sessions/{sessionId} {
        allow read, delete: if signedIn();
        allow create: if signedIn() && validSession(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid;
        allow update: if signedIn() && validSession(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
      }
    }
  }
}
